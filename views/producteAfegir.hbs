<section class="form-page">

    <h2 class="page-title">Afegir producte</h2>

    <form action="/productes/create" method="POST" class="form-card" onsubmit="return validarForm()">

        <!-- NOM -->
        <div class="form-group">
            <label for="nom">Nom:</label>
            <input type="text" id="nom" name="nom" required>
        </div>

        <!-- CATEGORIA -->
        <div class="form-group">
            <label for="categoria">Categoria:</label>
            <input type="text" id="categoria" name="categoria" required>
        </div>

        <!-- PREU -->
        <div class="form-group">
            <label for="preu">Preu (€):</label>
            <input type="number" id="preu" name="preu" step="0.01" required>
        </div>

        <!-- STOCK -->
        <div class="form-group">
            <label for="stock">Stock:</label>
            <input type="number" id="stock" name="stock" required>
        </div>

        <!-- ACTIU -->
        <div class="form-group checkbox-group">
            <label>
                <input type="checkbox" name="active" checked>
                Actiu
            </label>
        </div>

        <!-- BOTONS -->
        <div class="form-buttons">
            <button type="submit" class="btn-submit">Guardar</button>
            <a href="/productes" class="btn-cancel">Cancel·lar</a>
        </div>

    </form>

</section>
