<section class="venda-veure-page">

    <h1 class="page-title">Detalls de la venda</h1>

    <!-- INFORMACIÓ GENERAL -->
    <div class="card info-card">
        <h2>Informació general</h2>

        <p><strong>ID venda:</strong> {{sale.id}}</p>
        <p><strong>Client:</strong> {{sale.client_name}}</p>
        <p><strong>Data:</strong> {{sale.sale_date}}</p>
        <p><strong>Total:</strong> {{sale.total}} €</p>
    </div>

    <!-- LÍNIES DE VENDA -->
    <div class="card lines-card">
        <h2>Línies de venda</h2>

        <table class="clients-table">
            <thead>
                <tr>
                    <th>Producte</th>
                    <th>Quantitat</th>
                    <th>Preu unitari</th>
                    <th>Total línia</th>
                </tr>
            </thead>

            <tbody>
                {{#each items}}
                <tr>
                    <td>{{name}}</td>
                    <td>{{qty}}</td>
                    <td>{{unit_price}} €</td>
                    <td>{{line_total}} €</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <!-- BOTÓ TORNAR -->
    <div class="actions-bar">
        <a href="/vendes" class="btn-back">← Tornar</a>
    </div>

</section>
