<section class="vendes-page">

    <h2 class="page-title">Vendes</h2>

    <!-- TAULA VENDES -->
    <table class="clients-table">
        <thead>
            <tr>
                <th>Data</th>
                <th>Client</th>
                <th>Total (€)</th>
                <th>Accions</th>
            </tr>
        </thead>

        <tbody>
            {{#each vendes}}
            <tr>
                <td>{{sale_date}}</td>
                <td>{{client_name}}</td>
                <td>{{total}}</td>

                <td class="acciones">
                    <a href="/vendes/veure?id={{id}}" class="btn-veure">Veure</a>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <!-- PAGINACIÓ -->
    <div class="pagination">
        {{#if pagina}}
            <a href="/vendes?pagina={{dec pagina}}" class="page-btn">← Anterior</a>
        {{/if}}

        <span class="page-number">Pàgina {{pagina}}</span>

        <a href="/vendes?pagina={{inc pagina}}" class="page-btn">Següent →</a>
    </div>

</section>
