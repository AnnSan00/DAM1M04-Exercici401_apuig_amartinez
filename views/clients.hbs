<section class="clients-page">

    <h1 class="page-title">Clients</h1>

    <!-- BUSCADOR MODERN -->
    <form method="GET" action="/clients" class="search-bar">

        <input 
            type="text" 
            name="cerca" 
            placeholder="Buscar per nom o email..." 
            value="{{cerca}}"
        >

        <label class="toggle-switch">
            <input type="checkbox" id="toggleVIP">
            <span class="slider"></span>
            <span class="toggle-text">Només VIP</span>
        </label>

        <button type="submit" class="btn-search">Buscar</button>
    </form>

    <!-- BOTÓ NOU CLIENT -->
    <div class="actions-bar">
        <a href="/clients/afegir" class="btn-afegir">
            <span class="icon">➕</span> Nou client
        </a>
    </div>

    <!-- TAULA CLIENTS -->
    <table class="clients-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Telèfon</th>
                <th>VIP</th>
                <th>Accions</th>
            </tr>
        </thead>

        <tbody>
            {{#each clients}}
            <tr>
                <td>{{name}}</td>
                <td>{{email}}</td>
                <td>{{phone}}</td>
                <td>{{#if vip}}Sí{{else}}No{{/if}}</td>
                <td class="acciones">

                    <!-- BOTÓ FITXA -->
                    <form action="/clients/fitxa" method="GET" class="inline-form">
                        <input type="hidden" name="id" value="{{id}}">
                        <button type="submit" class="btn-ver">Fitxa</button>
                    </form>

                    <!-- BOTÓ EDITAR -->
                    <form action="/clients/editar" method="GET" class="inline-form">
                        <input type="hidden" name="id" value="{{id}}">
                        <button type="submit" class="btn-editar">Editar</button>
                    </form>

                </td>

            </tr>
            {{/each}}
        </tbody>
    </table>

    <!-- PAGINACIÓ -->
    <div class="pagination">
        {{#if pagina}}
            <a href="/clients?pagina={{dec pagina}}&cerca={{cerca}}" class="page-btn">← Anterior</a>
        {{/if}}

        <span class="page-number">Pàgina {{pagina}}</span>

        <a href="/clients?pagina={{inc pagina}}&cerca={{cerca}}" class="page-btn">Següent →</a>
    </div>

</section>
