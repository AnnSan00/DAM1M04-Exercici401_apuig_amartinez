<!-- ==========================================
     DASHBOARD
========================================== -->

<h2>Dashboard</h2>


<!-- ==========================
     TOGGLE KPI
========================== -->

<label>
    <input type="checkbox" id="toggleCompacte">
    Mode compacte
</label>


<!-- ==========================
     KPI (CARDS)
========================== -->

<div class="kpi-container">

    <div class="kpi">
        <h3>Vendes avui</h3>
        <p>{{kpis.vendesAvui}} €</p>
    </div>

    <div class="kpi">
        <h3>Vendes mes</h3>
        <p>{{kpis.vendesMes}} €</p>
    </div>

    <div class="kpi">
        <h3>Comandes avui</h3>
        <p>{{kpis.comandesAvui}}</p>
    </div>

    <div class="kpi kpi-extra">
        <h3>Comandes mes</h3>
        <p>{{kpis.comandesMes}}</p>
    </div>

    <div class="kpi kpi-extra">
        <h3>Stock baix</h3>
        <p>{{kpis.stockBaix}}</p>
    </div>

</div>


<!-- ==========================================
     LLISTATS
========================================== -->

<h3>Llistats</h3>


<!-- ==========================
     TOGGLE COLORES STOCK
========================== -->

<label>
    <input type="checkbox" id="toggleColors">
    Activar colors stock
</label>


<!-- ==========================
     ÚLTIMES VENDES
========================== -->

<h4>Últimes vendes</h4>

<table>
    <thead>
        <tr>
            <th>Data</th>
            <th>Client</th>
            <th>Total (€)</th>
        </tr>
    </thead>

    <tbody>
        {{#each ultimesVendes}}
        <tr>
            <td>{{sale_date}}</td>
            <td>{{client_name}}</td>
            <td>{{total}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>


<!-- ==========================
     TOP PRODUCTES
========================== -->

<h4>Top productes</h4>

<table>
    <thead>
        <tr>
            <th>Producte</th>
            <th>Unitats venudes</th>
        </tr>
    </thead>

    <tbody>
        {{#each topProductes}}
        <tr>
            <td>{{name}}</td>
            <td>{{total_venuts}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>


<!-- ==========================
     PRODUCTES AMB STOCK BAIX
========================== -->

<h4>Productes amb stock baix</h4>

<table>
    <thead>
        <tr>
            <th>Nom</th>
            <th>Stock</th>
        </tr>
    </thead>

    <tbody>
        {{#each stockBaix}}
        <tr class="stock-{{stock}}">
            <td>{{name}}</td>
            <td>{{stock}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>