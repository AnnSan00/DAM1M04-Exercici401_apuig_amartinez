<!-- ==========================================
     DASHBOARD
========================================== -->

<section class="dashboard">


    <!-- ==========================
         CONTROLS SUPERIORS
    ========================== -->
    <div class="dashboard-controls">
        <label class="toggle-label">
            <input type="checkbox" id="toggleCompact">
            Mode compacte
        </label>
    </div>

    <!-- ==========================
         KPI (CARDS)
    ========================== -->
    <div class="kpi-container" id="kpi-grid">

        <div class="kpi">
            <div class="kpi-icon">💶</div>
            <h3>Vendes avui</h3>
            <p>{{kpis.vendesAvui}} €</p>
        </div>

        <div class="kpi">
            <div class="kpi-icon">📅</div>
            <h3>Vendes mes</h3>
            <p>{{kpis.vendesMes}} €</p>
        </div>

        <div class="kpi">
            <div class="kpi-icon">🛒</div>
            <h3>Comandes avui</h3>
            <p>{{kpis.comandesAvui}}</p>
        </div>

        <div class="kpi">
            <div class="kpi-icon">📦</div>
            <h3>Comandes mes</h3>
            <p>{{kpis.comandesMes}}</p>
        </div>

        <div class="kpi">
            <div class="kpi-icon">⚠️</div>
            <h3>Stock baix</h3>
            <p>{{kpis.stockBaix}}</p>
        </div>

    </div>

    <!-- ==========================================
         LLISTATS (AMAGABLES EN MODE COMPACTE)
    ========================================== -->
    <section class="llistats" id="llistats-section">

        <h3 class="section-title">Llistats</h3>

        <!-- ==========================
             ÚLTIMES VENDES
        ========================== -->
        <div class="list-block">
            <h4>Últimes vendes</h4>

            <table>
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Client</th>
                        <th>Total (€)</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each ultimesVendes}}
                    <tr>
                        <td>{{sale_date}}</td>
                        <td>{{client_name}}</td>
                        <td>{{total}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <!-- ==========================
             TOP PRODUCTES
        ========================== -->
        <div class="list-block">
            <h4>Top productes</h4>

            <table>
                <thead>
                    <tr>
                        <th>Producte</th>
                        <th>Unitats venudes</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each topProductes}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{total_venuts}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </section>

</section>
