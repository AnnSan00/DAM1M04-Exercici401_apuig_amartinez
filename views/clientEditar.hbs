<section class="client-form-page">

    <h1 class="page-title">Editar client</h1>

    <form action="/clients/update" method="POST" id="form-client" class="form-card">

        <input type="hidden" name="id" value="{{client.id}}">

        <div class="form-group">
            <label for="nom">Nom:</label>
            <input type="text" id="nom" name="nom" value="{{client.name}}" required>
        </div>

        <div class="form-group">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="{{client.email}}" required>
        </div>

        <div class="form-group">
            <label for="telefon">Telèfon:</label>
            <input type="tel" id="telefon" name="telefon" value="{{client.phone}}" required>
        </div>

        <button type="submit" class="btn-afegir">💾 Guardar canvis</button>
    </form>

    <!-- BOTÓ INACTIVAR CLIENT -->
    <form action="/clients/delete" method="POST" class="form-card">
        <input type="hidden" name="id" value="{{client.id}}">
        <button type="submit" class="btn-danger">🗑️ Inactivar client</button>
    </form>

</section>
