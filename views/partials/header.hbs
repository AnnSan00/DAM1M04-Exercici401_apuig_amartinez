        <!-- LOGO / TÍTOL -->
        <div class="logo">
            <a href="/" class="logo-link">
                <h1 class="logo-title">🛒 MiniERP</h1>
            </a>
            <small class="logo-subtitle">Gestió de botiga</small>
        </div>

        <!-- SELECTOR DE TEMA -->
