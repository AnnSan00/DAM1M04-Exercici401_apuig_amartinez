<header>
    <div class="header-container">

        <!-- LOGO / TÍTULO -->
        <div class="logo">
            <a href="/" style="text-decoration:none; color:white;">
                <h1>🛒 MiniERP</h1>
            </a>
            <small>Gestió de botiga</small>
        </div>

        <!-- SELECTOR DE TEMA -->
