<header class="page-header">
    <h1>Fitxa del Client: {{client.name}}</h1>
    <a href="/clientEditar?id={{client.id}}" class="btn">Editar Dades</a>
</header>

<div class="grid-2-cols">
    {{!-- Dades personals --}}
    <div class="card">
        <h3>Dades de Contacte</h3>
        <p><strong>📧 Email:</strong> {{client.email}}</p>
        <p><strong>📞 Telèfon:</strong> {{client.phone}}</p>
        <p><strong>⭐ Categoria:</strong> {{#if client.vip}}VIP{{else}}Estàndard{{/if}}</p>
    </div>

    {{!-- Resum de compres --}}
    <div class="card">
        <h3>Resum Econòmic</h3>
        <p class="kpi-value">{{totalGastat}}€</p>
        <p>Total gastat acumulat</p>
    </div>
</div>

<div class="card mt-20">
    <h3>Historial d'últimes 10 vendes</h3>
    <table class="main-table">
        <thead>
            <tr>
                <th>Data</th>
                <th>Total</th>
                <th>Accions</th>
            </tr>
        </thead>
        <tbody>
            {{#each compres}}
            <tr>
                <td>{{this.sale_date}}</td>
                <td>{{this.total}}€</td>
                <td><button class="btn-sm">Veure Ticket</button></td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>