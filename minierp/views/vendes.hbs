<h1>Historial de Vendes</h1>

<table class="main-table">
    <thead>
        <tr>
            <th>Data</th>
            <th>Client</th>
            <th>Total</th>
            <th>Accions</th>
        </tr>
    </thead>
    <tbody>
        {{#each vendes}}
        <tr>
            <td>{{this.sale_date}}</td>
            <td>{{this.customer_name}}</td>
            <td><strong>{{this.total}}€</strong></td>
            <td>
                <button class="btn-sm">Veure Ticket</button>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>