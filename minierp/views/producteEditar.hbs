<div class="card form-container">
    <h2>Editar Producte</h2>
    
    {{!-- Formulari d'actualització --}}
    <form action="/Update" method="POST">
        <input type="hidden" name="taula" value="productes">
        <input type="hidden" name="id" value="{{producte.id}}">

        <div class="form-group">
            <label>Nom:</label>
            <input type="text" name="name" value="{{producte.name}}" class="form-control" required>
        </div>

        <div class="grid-2-cols">
            <div class="form-group">
                <label>Preu:</label>
                <input type="number" name="price" value="{{producte.price}}" step="0.01" class="form-control">
            </div>
            <div class="form-group">
                <label>Stock:</label>
                <input type="number" name="stock" value="{{producte.stock}}" class="form-control">
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">Actualitzar</button>
            <a href="/productes" class="btn btn-outline">Tornar</a>
        </div>
    </form>

    <hr>

    {{!-- Botó d'esborrar separat (Requisit POST a /Delete) --}}
    <form action="/Delete" method="POST" onsubmit="return confirm('Segur que vols esborrar-lo?')">
        <input type="hidden" name="taula" value="productes">
        <input type="hidden" name="id" value="{{producte.id}}">
        <button type="submit" class="btn btn-danger">🗑️ Esborrar Producte</button>
    </form>
</div>