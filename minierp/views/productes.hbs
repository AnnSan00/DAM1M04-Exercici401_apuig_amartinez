<header class="list-header">
    <h2>Gestió de Productes</h2>
    <a href="/producteAfegir" class="btn btn-success">+ Nou Producte</a>
</header>

<form action="/productes" method="GET" class="search-form">
    <input type="text" name="cerca" placeholder="Cerca per nom o categoria...">
    <button type="submit">Buscar</button>
</form>

<table class="main-table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Categoria</th>
            <th>Preu</th>
            <th>Stock</th>
            <th>Accions</th>
        </tr>
    </thead>
    <tbody>
        {{#each productes}}
        <tr class="{{#if (lt this.stock 5)}}stock-crit{{else if (lt this.stock 15)}}stock-low{{else}}stock-ok{{/if}}">
            <td>{{this.name}}</td>
            <td>{{this.category}}</td>
            <td>{{this.price}}€</td>
            <td>{{this.stock}}</td>
            <td>
                <a href="/producteEditar?id={{this.id}}">✏️ Editar</a>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

<div class="pagination">
    <a href="/productes?pagina={{prev}}">⬅️ Anterior</a>
    <span>Pàgina {{actual}}</span>
    <a href="/productes?pagina={{next}}">Següent ➡️</a>
</div>