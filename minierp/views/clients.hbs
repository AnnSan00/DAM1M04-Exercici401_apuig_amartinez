<div class="header-split">
    <h1>Gestió de Clients</h1>
    <a href="/clientAfegir" class="btn">+ Nou Client</a>
</div>

{{!-- Cercador segons enunciat --}}
<form action="/clients" method="GET" class="search-form card">
    <input type="text" name="cerca" placeholder="Nom o email...">
    <label><input type="checkbox" name="vip"> Només VIP</label>
    <button type="submit" class="btn">Filtrar</button>
</form>

<table class="main-table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Telèfon</th>
            <th>Accions</th>
        </tr>
    </thead>
    <tbody>
        {{#each clients}}
        <tr>
            <td>{{this.name}}</td>
            <td>{{this.email}}</td>
            <td>{{this.phone}}</td>
            <td>
                <a href="/clientFitxa?id={{this.id}}" class="btn-sm">👁️ Fitxa</a>
                <a href="/clientEditar?id={{this.id}}" class="btn-sm">✏️ Editar</a>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

{{!-- Paginació de 10 en 10 --}}
<div class="pagination">
    <a href="/clients?pagina={{prev}}" class="btn">Anterior</a>
    <span>Pàgina {{actual}}</span>
    <a href="/clients?pagina={{next}}" class="btn">Següent</a>
</div>